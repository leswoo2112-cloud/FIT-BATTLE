/* =========================
   FIT BATTLE 게임형 디자인
========================= */

:root {
  --bg: #050815;
  --bg-soft: #0b1022;

  --panel: #11172b;
  --panel-light: #18213c;

  --line: rgba(255, 255, 255, 0.09);

  --text: #ffffff;
  --muted: #97a3be;

  --blue: #2f8cff;
  --blue-soft: rgba(47, 140, 255, 0.18);

  --red: #ff4058;
  --red-soft: rgba(255, 64, 88, 0.18);

  --yellow: #ffc629;
  --yellow-soft: rgba(255, 198, 41, 0.16);

  --purple: #8c5bff;
  --purple-soft: rgba(140, 91, 255, 0.18);

  --green: #35e291;
  --green-soft: rgba(53, 226, 145, 0.16);

  --shadow:
    0 18px 45px rgba(0, 0, 0, 0.34);

  --radius: 20px;
  --radius-small: 13px;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  color: var(--text);
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Pretendard",
    "Noto Sans KR",
    "Segoe UI",
    sans-serif;
  background:
    radial-gradient(
      circle at 20% 0%,
      rgba(47, 140, 255, 0.14),
      transparent 31%
    ),
    radial-gradient(
      circle at 90% 15%,
      rgba(140, 91, 255, 0.14),
      transparent 28%
    ),
    linear-gradient(
      180deg,
      #060a18,
      #030610
    );
}

button,
input,
select {
  font: inherit;
}

button {
  color: inherit;
  cursor: pointer;
}

input,
select {
  width: 100%;
  min-height: 47px;
  padding: 0 13px;
  border: 1px solid var(--line);
  border-radius: 11px;
  outline: none;
  color: var(--text);
  background: #121a30;
}

input:focus,
select:focus {
  border-color: var(--yellow);
  box-shadow:
    0 0 0 3px rgba(255, 198, 41, 0.12);
}

option {
  color: var(--text);
  background: #121a30;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

.page {
  display: none;
}

.page.active {
  display: block;
  animation: pageOpen 0.2s ease;
}

@keyframes pageOpen {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================
   공통 카드
========================= */

.card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background:
    linear-gradient(
      145deg,
      rgba(24, 33, 60, 0.97),
      rgba(10, 15, 31, 0.98)
    );
  box-shadow: var(--shadow);
}

.label {
  color: var(--yellow);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}

.section-head,
.control-head,
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.section-head h2,
.control-head h2,
.modal-head h2 {
  margin: 5px 0 0;
}

/* =========================
   상단
========================= */

.topbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 104px;
  z-index: 100;
  display: flex;
  min-height: 82px;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding:
    0 max(24px, env(safe-area-inset-right))
    0 24px;
  border-bottom: 1px solid var(--line);
  background: rgba(5, 8, 21, 0.93);
  backdrop-filter: blur(18px);
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-icon {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 14px;
  font-size: 26px;
  background:
    linear-gradient(
      145deg,
      var(--yellow),
      #ff8d1f
    );
  box-shadow:
    0 0 25px rgba(255, 198, 41, 0.25);
}

.logo-area h1 {
  margin-bottom: 2px;
  font-size: 25px;
  font-style: italic;
  letter-spacing: 0.8px;
}

.logo-area p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

.top-stats {
  display: flex;
  align-items: center;
  gap: 9px;
}

.stat-pill {
  display: flex;
  min-height: 42px;
  align-items: center;
  gap: 7px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: #11182c;
}

.stat-pill strong {
  color: var(--yellow);
  font-size: 14px;
}

.small-btn {
  min-height: 42px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 11px;
  font-weight: 800;
  background: #161f38;
}

/* =========================
   왼쪽 메뉴
========================= */

.side-menu {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 110;
  display: flex;
  width: 104px;
  flex-direction: column;
  gap: 11px;
  padding:
    max(18px, env(safe-area-inset-top))
    10px
    max(18px, env(safe-area-inset-bottom));
  border-right: 1px solid var(--line);
  background:
    linear-gradient(
      180deg,
      rgba(12, 17, 36, 0.98),
      rgba(5, 8, 21, 0.98)
    );
}

.menu-btn {
  display: flex;
  min-height: 88px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid transparent;
  border-radius: 17px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 900;
  background: transparent;
  transition:
    transform 0.15s ease,
    background 0.15s ease,
    color 0.15s ease;
}

.menu-btn span {
  font-size: 27px;
}

.menu-btn:hover {
  transform: translateY(-2px);
  color: var(--text);
  background: rgba(255, 255, 255, 0.04);
}

.menu-btn.active {
  border-color: rgba(140, 91, 255, 0.5);
  color: #ffffff;
  background:
    linear-gradient(
      145deg,
      #7447ff,
      #9b65ff
    );
  box-shadow:
    0 0 26px rgba(140, 91, 255, 0.28);
}

/* =========================
   메인
========================= */

.main {
  min-height: 100vh;
  margin-left: 104px;
  padding:
    102px
    max(22px, env(safe-area-inset-right))
    35px
    max(22px, env(safe-area-inset-left));
}

.battle-grid {
  display: grid;
  grid-template-columns:
    minmax(560px, 1.35fr)
    minmax(300px, 0.65fr);
  gap: 16px;
  max-width: 1500px;
  margin: auto;
}

/* =========================
   팀 점수판
========================= */

.scoreboard {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 90px 1fr;
  min-height: 235px;
  align-items: center;
  padding: 30px;
  overflow: hidden;
  background:
    linear-gradient(
      115deg,
      rgba(22, 70, 155, 0.52),
      rgba(17, 23, 43, 0.97) 48%,
      rgba(159, 27, 53, 0.5)
    );
}

.team {
  display: flex;
  align-items: center;
  gap: 18px;
}

.team-red {
  justify-content: flex-end;
  text-align: right;
}

.team-logo {
  display: grid;
  width: 90px;
  height: 90px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  font-size: 48px;
  background: rgba(255, 255, 255, 0.08);
}

.team span {
  display: block;
  margin-bottom: 7px;
  color: #dce7ff;
  font-size: 18px;
  font-weight: 900;
}

.team strong {
  display: block;
  font-size: clamp(52px, 7vw, 85px);
  line-height: 0.95;
}

.team-blue strong {
  color: #54a5ff;
  text-shadow:
    0 0 25px rgba(47, 140, 255, 0.35);
}

.team-red strong {
  color: #ff5e72;
  text-shadow:
    0 0 25px rgba(255, 64, 88, 0.35);
}

.versus {
  color: #ffffff;
  font-size: 33px;
  font-style: italic;
  font-weight: 1000;
  text-align: center;
}

.score-progress {
  position: absolute;
  right: 30px;
  bottom: 22px;
  left: 30px;
  display: flex;
  height: 15px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
}

.blue-score-bar,
.red-score-bar {
  width: 50%;
  height: 100%;
  transition: width 0.35s ease;
}

.blue-score-bar {
  background:
    linear-gradient(
      90deg,
      #1f70ff,
      #55b2ff
    );
}

.red-score-bar {
  background:
    linear-gradient(
      90deg,
      #ff6175,
      #ff2947
    );
}

/* =========================
   미션 카드
========================= */

.mission-card {
  position: relative;
  min-height: 235px;
  padding: 27px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 90% 40%,
      rgba(140, 91, 255, 0.28),
      transparent 40%
    ),
    linear-gradient(
      145deg,
      #29193f,
      #12162b
    );
}

.mission-card h2 {
  max-width: 70%;
  margin: 11px 0 8px;
  font-size: 25px;
}

.mission-card p {
  max-width: 68%;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.6;
}

.mission-character {
  position: absolute;
  top: 35px;
  right: 32px;
  font-size: 80px;
  filter: drop-shadow(
    0 10px 12px rgba(0, 0, 0, 0.3)
  );
}

.mission-progress {
  position: absolute;
  right: 26px;
  bottom: 23px;
  left: 26px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px;
  align-items: center;
}

.progress-track {
  height: 13px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.35);
}

.progress-fill {
  width: 0;
  height: 100%;
  border-radius: inherit;
  background:
    linear-gradient(
      90deg,
      #8d5bff,
      #ca78ff
    );
  transition: width 0.3s ease;
}

.mission-progress strong {
  min-width: 48px;
  color: #d8c4ff;
  font-size: 13px;
}

/* =========================
   현재 운동
========================= */

.current-exercise {
  min-height: 420px;
  padding: 25px;
  text-align: center;
}

.exercise-big-image {
  display: grid;
  width: 135px;
  height: 135px;
  place-items: center;
  margin: 20px auto 14px;
  border: 2px solid rgba(255, 198, 41, 0.35);
  border-radius: 30px;
  font-size: 74px;
  background:
    radial-gradient(
      circle,
      rgba(255, 198, 41, 0.18),
      transparent 70%
    ),
    #11182c;
}

.current-exercise h2 {
  margin-bottom: 7px;
  font-size: 26px;
}

.current-exercise p {
  color: var(--muted);
  font-size: 11px;
}

.timer-box {
  margin-top: 20px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #0c1224;
}

.timer-box span {
  display: block;
  color: var(--muted);
  font-size: 9px;
}

.timer-box strong {
  display: block;
  margin-top: 5px;
  color: var(--yellow);
  font-size: 44px;
  line-height: 1;
}

.timer-buttons {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 8px;
  margin-top: 12px;
}

.start-btn,
.dark-btn {
  min-height: 47px;
  border-radius: 11px;
  font-weight: 900;
}

.start-btn {
  border: 1px solid rgba(53, 226, 145, 0.45);
  color: #03150b;
  background:
    linear-gradient(
      145deg,
      #52f4a8,
      #2acb7d
    );
}

.dark-btn {
  border: 1px solid var(--line);
  background: #141d34;
}

/* =========================
   게임 진행
========================= */

.game-control {
  min-height: 420px;
  padding: 25px;
}

.round-display {
  min-width: 75px;
  padding: 10px;
  border: 1px solid rgba(255, 198, 41, 0.35);
  border-radius: 12px;
  color: var(--muted);
  font-size: 8px;
  text-align: center;
  background: var(--yellow-soft);
}

.round-display strong {
  display: block;
  margin-top: 3px;
  color: var(--yellow);
  font-size: 23px;
}

.simple-field {
  display: grid;
  gap: 7px;
  margin-top: 15px;
}

.simple-field span {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
}

.score-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 15px;
  padding: 15px;
  border: 1px solid rgba(140, 91, 255, 0.36);
  border-radius: 12px;
  color: #c6b3f3;
  font-size: 11px;
  background: var(--purple-soft);
}

.score-preview strong {
  color: #d7c9ff;
  font-size: 22px;
}

.game-start-btn {
  width: 100%;
  min-height: 57px;
  margin-top: 15px;
  border: 0;
  border-radius: 14px;
  color: #251900;
  font-size: 16px;
  font-weight: 1000;
  background:
    linear-gradient(
      145deg,
      #ffe168,
      #ffb510
    );
  box-shadow:
    0 10px 25px rgba(255, 198, 41, 0.2);
}

.next-round-btn {
  width: 100%;
  min-height: 45px;
  margin-top: 9px;
  border: 1px solid var(--line);
  border-radius: 11px;
  font-weight: 900;
  background: #151e36;
}

/* =========================
   운동 카드 선택
========================= */

.exercise-select {
  grid-column: 1 / -1;
  padding: 25px;
}

.random-btn {
  min-height: 42px;
  padding: 0 15px;
  border: 1px solid rgba(140, 91, 255, 0.4);
  border-radius: 11px;
  color: #d9ccff;
  font-weight: 900;
  background: var(--purple-soft);
}

.exercise-card-list {
  display: grid;
  grid-template-columns:
    repeat(5, minmax(150px, 1fr));
  gap: 13px;
  margin-top: 18px;
}

.exercise-card {
  position: relative;
  min-height: 230px;
  padding: 15px;
  border: 2px solid transparent;
  border-radius: 18px;
  text-align: center;
  background:
    linear-gradient(
      180deg,
      #f5f7fb,
      #dce3ee
    );
  transition:
    transform 0.16s ease,
    border-color 0.16s ease;
}

.exercise-card:hover {
  transform: translateY(-4px);
}

.exercise-card.selected {
  border-color: #38a3ff;
  box-shadow:
    0 0 0 4px rgba(47, 140, 255, 0.16);
}

.exercise-card.selected::after {
  position: absolute;
  top: 10px;
  right: 10px;
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 13px;
  content: "✓";
  background: var(--blue);
}

.exercise-card-image {
  display: grid;
  min-height: 125px;
  place-items: center;
  font-size: 75px;
}

.exercise-card h3 {
  margin: 8px 0 7px;
  color: #11182b;
  font-size: 16px;
}

.exercise-card p {
  margin: 0;
  color: #657086;
  font-size: 10px;
}

.exercise-card strong {
  display: block;
  margin-top: 9px;
  color: #ff6d2f;
  font-size: 13px;
}

/* =========================
   보상 카드
========================= */

.reward-card {
  grid-column: 1 / -1;
  padding: 24px;
}

.reward-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 11px;
  margin-top: 16px;
}

.reward-item {
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 13px;
  text-align: center;
  background: #11192e;
}

.reward-item span {
  display: block;
  font-size: 34px;
}

.reward-item strong {
  display: block;
  margin-top: 6px;
  color: var(--yellow);
  font-size: 16px;
}

.reward-item small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 9px;
}
/* =========================
   공통 페이지
========================= */

.page-card {
  max-width: 1450px;
  min-height: 620px;
  margin: auto;
  padding: 26px;
}

.page-card h2 {
  margin-bottom: 0;
  font-size: 27px;
}

/* =========================
   전체 운동 목록
========================= */

.all-exercise-list {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(180px, 1fr));
  gap: 14px;
  margin-top: 20px;
}

.exercise-manage-card {
  position: relative;
  min-height: 250px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 18px;
  text-align: center;
  background:
    linear-gradient(
      145deg,
      #17213d,
      #0d1429
    );
}

.exercise-manage-image {
  display: grid;
  width: 110px;
  height: 110px;
  place-items: center;
  margin: 0 auto 15px;
  border: 1px solid rgba(255, 198, 41, 0.25);
  border-radius: 25px;
  font-size: 63px;
  background: var(--yellow-soft);
}

.exercise-manage-card h3 {
  margin-bottom: 7px;
  font-size: 18px;
}

.exercise-manage-card p {
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 11px;
}

.exercise-manage-card strong {
  color: var(--yellow);
  font-size: 15px;
}

.delete-exercise-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  border: 1px solid rgba(255, 64, 88, 0.35);
  border-radius: 10px;
  color: #ff8c9d;
  background: var(--red-soft);
}

/* =========================
   순위 화면
========================= */

.ranking-list {
  display: grid;
  gap: 12px;
  margin-top: 22px;
}

.ranking-row {
  display: grid;
  grid-template-columns: 65px 1fr auto;
  gap: 16px;
  align-items: center;
  min-height: 95px;
  padding: 16px 20px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background:
    linear-gradient(
      145deg,
      #17213d,
      #0f162c
    );
}

.ranking-row:first-child {
  border-color:
    rgba(255, 198, 41, 0.48);
  background:
    linear-gradient(
      145deg,
      rgba(255, 198, 41, 0.15),
      #131a30
    );
}

.ranking-number {
  display: grid;
  width: 50px;
  height: 50px;
  place-items: center;
  border-radius: 50%;
  color: var(--yellow);
  font-size: 20px;
  font-weight: 1000;
  background: var(--yellow-soft);
}

.ranking-row h3 {
  margin-bottom: 4px;
  font-size: 18px;
}

.ranking-row p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.ranking-score {
  color: var(--green);
  font-size: 30px;
  font-weight: 1000;
}

/* =========================
   운동 기록
========================= */

.record-list {
  display: grid;
  gap: 10px;
  margin-top: 20px;
}

.record-row {
  display: grid;
  grid-template-columns:
    80px 1fr auto;
  gap: 14px;
  align-items: center;
  min-height: 82px;
  padding: 14px 17px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: #11192e;
}

.record-row time {
  color: var(--muted);
  font-size: 10px;
}

.record-row h3 {
  margin-bottom: 5px;
  font-size: 14px;
}

.record-row p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

.record-score {
  color: var(--yellow);
  font-size: 22px;
  font-weight: 1000;
}

.empty-state {
  display: grid;
  min-height: 300px;
  place-items: center;
  color: var(--muted);
  text-align: center;
}

.empty-state span {
  display: block;
  margin-bottom: 11px;
  font-size: 58px;
}

/* =========================
   버튼
========================= */

.danger-btn {
  min-height: 42px;
  padding: 0 15px;
  border: 1px solid
    rgba(255, 64, 88, 0.38);
  border-radius: 11px;
  color: #ff9aaa;
  font-weight: 900;
  background: var(--red-soft);
}

.full-btn {
  width: 100%;
  margin-top: 10px;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

/* =========================
   팝업
========================= */

.modal {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: none;
  place-items: center;
  padding: 20px;
  background:
    rgba(2, 4, 12, 0.86);
  backdrop-filter: blur(12px);
}

.modal.open {
  display: grid;
}

.modal-card {
  width: min(460px, 100%);
  max-height: 90vh;
  padding: 26px;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      #18213c,
      #0b1124
    );
  box-shadow: var(--shadow);
}

.close-btn {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #11192e;
}

/* =========================
   완료 효과
========================= */

.success-overlay {
  position: fixed;
  inset: 0;
  z-index: 400;
  display: none;
  place-items: center;
  padding: 20px;
  background:
    rgba(2, 4, 12, 0.9);
  backdrop-filter: blur(14px);
}

.success-overlay.show {
  display: grid;
}

.success-card {
  width: min(430px, 100%);
  padding: 36px;
  border: 1px solid
    rgba(255, 198, 41, 0.45);
  border-radius: 25px;
  text-align: center;
  background:
    radial-gradient(
      circle at top,
      rgba(255, 198, 41, 0.2),
      transparent 48%
    ),
    #11182c;
  box-shadow: var(--shadow);
  animation: successOpen 0.25s ease;
}

@keyframes successOpen {
  from {
    opacity: 0;
    transform: scale(0.88);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.success-icon {
  font-size: 78px;
}

.success-card h2 {
  margin: 15px 0 7px;
  font-size: 31px;
}

.success-card p {
  color: var(--muted);
  line-height: 1.6;
}

/* =========================
   알림
========================= */

.toast {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 500;
  max-width: 360px;
  padding: 14px 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  opacity: 0;
  pointer-events: none;
  font-size: 11px;
  font-weight: 900;
  background:
    rgba(20, 29, 52, 0.97);
  box-shadow: var(--shadow);
  transform: translateY(15px);
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

/* =========================
   태블릿
========================= */

@media (max-width: 1100px) {
  .battle-grid {
    grid-template-columns: 1fr;
  }

  .exercise-select,
  .reward-card {
    grid-column: auto;
  }

  .exercise-card-list {
    grid-template-columns:
      repeat(3, minmax(150px, 1fr));
  }

  .all-exercise-list {
    grid-template-columns:
      repeat(3, minmax(170px, 1fr));
  }
}

/* =========================
   작은 태블릿·모바일
========================= */

@media (max-width: 760px) {
  .topbar {
    right: 0;
    left: 0;
    min-height: 66px;
    padding:
      0 12px;
  }

  .logo-icon {
    width: 38px;
    height: 38px;
    font-size: 21px;
  }

  .logo-area h1 {
    font-size: 18px;
  }

  .logo-area p {
    display: none;
  }

  .top-stats {
    gap: 4px;
  }

  .stat-pill {
    min-height: 35px;
    padding: 0 8px;
    font-size: 9px;
  }

  .small-btn {
    min-height: 35px;
    padding: 0 8px;
    font-size: 9px;
  }

  .side-menu {
    top: auto;
    right: 0;
    bottom: 0;
    width: auto;
    height: 69px;
    flex-direction: row;
    justify-content: space-around;
    padding:
      5px
      max(5px, env(safe-area-inset-right))
      max(5px, env(safe-area-inset-bottom))
      max(5px, env(safe-area-inset-left));
    border-top: 1px solid var(--line);
    border-right: 0;
  }

  .menu-btn {
    width: 25%;
    min-height: 55px;
    gap: 2px;
    border-radius: 11px;
    font-size: 8px;
  }

  .menu-btn span {
    font-size: 20px;
  }

  .main {
    margin-left: 0;
    padding:
      80px
      10px
      85px;
  }

  .scoreboard {
    grid-template-columns: 1fr 46px 1fr;
    min-height: 190px;
    padding: 20px 15px 36px;
  }

  .team {
    gap: 8px;
  }

  .team-logo {
    width: 53px;
    height: 53px;
    font-size: 30px;
  }

  .team span {
    font-size: 12px;
  }

  .team strong {
    font-size: 43px;
  }

  .versus {
    font-size: 22px;
  }

  .score-progress {
    right: 15px;
    bottom: 17px;
    left: 15px;
  }

  .mission-card {
    min-height: 210px;
    padding: 20px;
  }

  .mission-character {
    top: 40px;
    right: 18px;
    font-size: 60px;
  }

  .mission-card h2 {
    max-width: 67%;
    font-size: 21px;
  }

  .current-exercise,
  .game-control,
  .exercise-select,
  .reward-card,
  .page-card {
    padding: 18px;
  }

  .exercise-card-list,
  .all-exercise-list {
    grid-template-columns:
      repeat(2, minmax(135px, 1fr));
  }

  .exercise-card {
    min-height: 205px;
    padding: 11px;
  }

  .exercise-card-image {
    min-height: 105px;
    font-size: 63px;
  }

  .reward-list {
    grid-template-columns: 1fr 1fr;
  }

  .record-row {
    grid-template-columns: 1fr auto;
  }

  .record-row time {
    grid-column: 1 / -1;
  }
}

/* =========================
   아주 작은 화면
========================= */

@media (max-width: 420px) {
  .top-stats .stat-pill:nth-child(2) {
    display: none;
  }

  .team-logo {
    display: none;
  }

  .exercise-card-list,
  .all-exercise-list {
    grid-template-columns: 1fr;
  }

  .reward-list {
    grid-template-columns: 1fr;
  }

  .timer-buttons {
    grid-template-columns: 1fr;
  }

  .ranking-row {
    grid-template-columns: 48px 1fr;
  }

  .ranking-score {
    grid-column: 2;
  }
}